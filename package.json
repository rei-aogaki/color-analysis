{
  "name": "color-analysis",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "rei-aogaki",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts",
    "build": "npm run typecheck && vite build && node scripts/prepare-dist.mjs",
    "build:pages": "npm run typecheck && vite build --mode pages && node scripts/prepare-dist.mjs --pages",
    "audit:source": "node scripts/release-audit.mjs source",
    "audit:history": "node scripts/release-audit.mjs history",
    "audit:dist": "node scripts/release-audit.mjs dist",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node tests/browser/check.mjs",
    "test:design": "node tests/browser/design.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
